# Vite client env (inlined at build time). Copy to .env.local for local dev.
# VITE_CHAIN: sepolia | anvil
VITE_CHAIN=anvil
# TipSplitter address on that chain. Anvil account 0 / nonce 0 deploys to this address.
VITE_TIPSPLITTER_ADDRESS=0x5FbDB2315678afecb367f032d93F642f64180aa3
# Optional read RPC used when no wallet is injected.
# VITE_RPC_URL=http://127.0.0.1:8545
# Published TipSplitter package on Sui testnet. This is public configuration, not a secret.
VITE_SUI_PACKAGE_ID=0x216c007845ef2918161f03636cae3bf6f033c5560d1d4d135cdca78a807aee1f
